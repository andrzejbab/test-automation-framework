# Browser-accessible Codespaces environment
# Use this file when you open the workspace in a browser via Codespaces preview.
# Replace <CODESPACE_HOST> with your preview hostname (e.g. <hash>-8000.githubpreview.dev)

# Frontend: leave empty to let the app use `window.location.origin` (recommended)
REACT_APP_API_HOST=
REACT_APP_FRONTEND_HOST=

# Backend
# If you want an explicit backend URL, set it e.g. https://<CODESPACE_HOST>
BACKEND_HOST=
FRONTEND_HOST=

# Important host entries so Django accepts preview hostnames
# Include the preview domains and your specific preview host if known
ALLOWED_HOSTS=localhost,127.0.0.1,.githubpreview.dev,.preview.app.github.dev,<CODESPACE_HOST>
CSRF_TRUSTED_ORIGINS=https://*.githubpreview.dev,https://*.preview.app.github.dev,https://<CODESPACE_HOST>


SECRET_KEY=@9r-o=5(%2#b=y3fht1ndf1tc*!1(bfwyc8h-nb8s)ob+v741+

# Django admin (can remain the same as local .env)
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_EMAIL=admin@local.local
DJANGO_ADMIN_PASSWORD=1234567

# Tests
TEST_API_ADMIN_USERNAME=admin
TEST_API_ADMIN_PASSWORD=1234567
TEST_API_BASE_URL=
MAILPIT_HOST=http://127.0.0.1:8025
TEST_UI_BASE_URL=
UI_BROWSER=chrome
MOBILE=false

# UI Test headless = false / Browser under codespace
UI_HEADLESS=false
DISPLAY=:99
CHROME_BINARY=/usr/bin/google-chrome

# Notes:
# - Leave REACT_APP_API_HOST empty so frontend uses window.location.origin when served
#   via the Codespaces preview (recommended). Otherwise set it to the preview URL.
# - Replace <CODESPACE_HOST> with your actual preview hostname or keep the wildcard
#   entries so Django accepts the proxy hostnames.