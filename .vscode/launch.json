{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current pytest file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-s", "${file}"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DISPLAY": ":99",
                "CHROME_BINARY": "/usr/bin/google-chrome",
                "UI_HEADLESS": "false"
            },
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}